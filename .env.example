# Copy to .env and fill in. Never commit .env.

# --- Network (Monad testnet) ---
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
# Optional private RPC (QuickNode / Dwellir) for bots and keeper — public RPC is rate-limited (50 rps)
MONAD_RPC_URL_PRIVATE=
CHAIN_ID=10143

# --- Deployer / bot keys (testnet only; fund each with >10 MON — Monad reserve balance) ---
DEPLOYER_PRIVATE_KEY=
PUBLISHER_B_PRIVATE_KEY=
PUBLISHER_C_PRIVATE_KEY=
KEEPER_PRIVATE_KEY=
MM_PRIVATE_KEY=

# --- Oracle publishers (simulated testnet index) ---
# 32-byte hex secret shared by the team's publishers and the CRE workflow. Per-period seeds derived from it
# are committed onchain before use and revealed afterwards. Generate with: echo 0x$(openssl rand -hex 32)
PRICE_MASTER_SECRET=
# Optional RPC override for bots (defaults to MONAD_RPC_URL_PRIVATE, then MONAD_RPC_URL)
BOT_RPC_URL=

# --- Contract verification ---
MONADSCAN_API_KEY=

# --- Kuru (testnet) ---
KURU_ROUTER=0x7EFbE105Ca7415dE98F96622173458ac1c054630
KURU_MARGIN_ACCOUNT=0xd029C2D98ff85D8F64799017fE00a59B1159CE02

# --- Chainlink CRE ---
# Wallet that pays gas for `cre workflow simulate --broadcast` (simulation mode; testnet only)
CRE_SIMULATOR_PRIVATE_KEY=
# Simulation forwarder (cre workflow simulate --broadcast) on monad-testnet
CRE_FORWARDER_SIMULATION=0xB9F79d863261869B234c481D1f9A7af84AeAd192
# Production forwarder: run `cre workflow supported-chains` after deploy access is granted
CRE_FORWARDER_PRODUCTION=

# --- App ---
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
