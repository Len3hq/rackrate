# Optional: a dedicated Monad testnet RPC for the app (defaults to the public https://testnet-rpc.monad.xyz).
# This value is shipped to the browser, so never put a private or paid key here.
NEXT_PUBLIC_MONAD_RPC_URL=
# Public URL of the deployed site, used for social preview links.
NEXT_PUBLIC_SITE_URL=
# Optional: GraphQL endpoint of the Rackrate indexer (indexer/). Enables Portfolio history and recent trades.
# Local: http://localhost:8082/v1/graphql (after `indexer/scripts/local.sh start`); hosted: the Envio Cloud endpoint.
NEXT_PUBLIC_INDEXER_URL=
